---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import { projects, total } from '../data/catalog';
const sorted = [...projects].sort(
  (a, b) => Number(!!a.archived) - Number(!!b.archived) || total(b) - total(a),
);
---

<Layout title="Projects — Anvian">
  <section
    class="mx-auto min-h-[60vh] max-w-[1440px] px-[5%] py-[65px] pt-[70px] max-[700px]:px-[6%] max-[700px]:py-[45px] max-[700px]:pt-[45px] [&>p]:max-w-[65ch]"
  >
    <h1>
      Find your next
      <br />
      <em>little adventure.</em>
    </h1>
    <p>
      Mods, packs, and experiments. Pick something that makes your world yours.
    </p>
    <form
      class="mt-[45px] mb-[22px] grid grid-cols-[2fr_1fr_1fr] gap-5 max-[700px]:grid-cols-2 max-[700px]:gap-4 [&_input]:min-h-12 [&_input]:w-full [&_input]:rounded-[5px] [&_input]:border [&_input]:border-[#566451] [&_input]:bg-surface [&_input]:p-3 [&_input]:text-[.95rem] [&_input]:text-text [&_input]:placeholder:text-muted [&_label]:grid [&_label]:gap-2.5 [&_label]:text-[.82rem] [&_label]:text-muted [&_select]:min-h-12 [&_select]:w-full [&_select]:rounded-[5px] [&_select]:border [&_select]:border-[#566451] [&_select]:bg-surface [&_select]:p-3 [&_select]:text-[.95rem] [&_select]:text-text max-[700px]:[&>label:first-child]:col-span-full"
      role="search"
    >
      <label>
        Search projects
        <input id="search" type="search" placeholder="Search by name…" />
      </label>
      <label>
        Project type
        <select id="type">
          <option value="">All projects</option>
          <option value="mod">Mods</option>
          <option value="modpack">Modpacks</option>
          <option value="resourcepack">Resource packs</option>
          <option value="datapack">Datapacks</option>
        </select>
      </label>
      <label>
        Sort by
        <select id="sort">
          <option value="downloads">Most downloaded</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
    </form>
    <p class="mb-6 text-[.85rem]" id="results" role="status" aria-live="polite">
      {projects.length} projects
    </p>
    <div
      class="grid grid-cols-1 gap-5 min-[701px]:grid-cols-2 min-[1101px]:grid-cols-3"
      id="catalog"
    >
      {sorted.map((p) => <Project project={p} />)}
    </div>
    <p id="empty" hidden>
      No projects match. Try another name or project type.
    </p>
    <noscript>
      <p>All projects are shown. Enable JavaScript to search and filter.</p>
    </noscript>
  </section>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#search')!,
    type = document.querySelector<HTMLSelectElement>('#type')!,
    sort = document.querySelector<HTMLSelectElement>('#sort')!,
    catalog = document.querySelector<HTMLElement>('#catalog')!;
  const cards = Array.from(
    catalog.querySelectorAll<HTMLElement>('[data-project]'),
  );
  function update() {
    let visible = 0;
    cards.sort(
      (a, b) =>
        Number(a.dataset.archived === 'true') -
          Number(b.dataset.archived === 'true') ||
        (sort.value === 'name'
          ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '')
          : Number(b.dataset.downloads) - Number(a.dataset.downloads)),
    );
    for (const card of cards) {
      card.hidden = !(
        card.dataset.name?.includes(search.value.trim().toLowerCase()) &&
        (!type.value || card.dataset.type === type.value)
      );
      if (!card.hidden) visible++;
      catalog.append(card);
    }
    document.querySelector('#results')!.textContent =
      `${visible} ${visible === 1 ? 'project' : 'projects'}`;
    document.querySelector<HTMLElement>('#empty')!.hidden = visible > 0;
  }
  search.addEventListener('input', update);
  type.addEventListener('change', update);
  sort.addEventListener('change', update);
  document
    .querySelector('form')!
    .addEventListener('submit', (e) => e.preventDefault());
</script>
