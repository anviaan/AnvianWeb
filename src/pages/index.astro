---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import {projects,total} from '../data/catalog';
import {getCollection} from 'astro:content';
const posts=(await getCollection('blog',p=>!p.data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const ranked=[...projects].sort((a,b)=>total(b)-total(a)||a.name.localeCompare(b.name));
const highlights=ranked.filter(p=>p.featured&&!p.archived).slice(0,4);
const visual=projects.find(p=>p.id==='simple-mango');
---
<Layout image={visual?.image??undefined}>
<section class="hero intro" id="about"><div class="hero-copy"><h1>About me.<br/><em>Hi, I’m anvian.</em></h1><p>I build Minecraft mods, tools, and experiments. Sometimes it’s a new tree. Sometimes it’s a better way to test a mod. There’s always something else to explore.</p><p>You can find my projects and follow what I’m working on here.</p><div class="community"><a href="https://github.com/anviaan">GitHub ↗</a><a href="https://modrinth.com/user/anvian">Modrinth ↗</a><a href="https://www.curseforge.com/members/anvian/projects">CurseForge ↗</a><a href="https://x.com/carbajal_andre">X ↗</a></div></div><div class="skin-art"><img src="/images/anvian-skin.png" alt="anvian’s Minecraft character waving and turned toward the introduction" width="400" height="719" fetchpriority="high"/></div></section>
<section class="section"><div class="section-title"><div><h2>Small details. Big possibilities.</h2><p>A few things I’ve been building.</p></div><a class="text-link" href="/projects/">All projects ↗</a></div><div class="project-grid">{highlights.map(p=><Project project={p}/>)}</div></section>
<section class="section journal"><div class="section-title"><div><h2>From the workbench.</h2><p>Notes on modding, development, and figuring things out.</p></div><a class="text-link" href="/blog/">Read the blog ↗</a></div>{posts.slice(0,3).map(p=><a class="post-row" href={`/blog/${p.id}/`}>{p.data.image&&<img src={'/'+p.data.image.replace(/^\//,'')} alt="" width="230" height="140" loading="lazy"/>}<time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><div><h3>{p.data.title}</h3><p>{p.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</section>

</Layout>
