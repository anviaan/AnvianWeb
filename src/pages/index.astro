---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { projects, total } from '../data/catalog';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const ranked = [...projects].sort(
  (a, b) => total(b) - total(a) || a.name.localeCompare(b.name),
);
const highlights = ranked.filter((p) => p.featured && !p.archived).slice(0, 4);
const visual = projects.find((p) => p.id === 'simple-mango');
---

<Layout image={visual?.image ?? undefined}>
  <section
    class="mx-auto grid min-h-[640px] max-w-[1440px] grid-cols-[1.2fr_1fr] items-center gap-9 px-[5%] pt-16 pb-[78px] max-[1100px]:min-h-[560px] max-[700px]:min-h-0 max-[700px]:grid-cols-1 max-[700px]:gap-[30px] max-[700px]:px-[6%] max-[700px]:py-[45px] [&_h1]:text-[clamp(2.4rem,4.5vw,4.8rem)] max-[700px]:[&_h1]:text-[clamp(2.2rem,8vw,3.5rem)]"
    id="about"
  >
    <div
      class="relative z-1 [&>p]:my-6 [&>p]:max-w-[55ch] [&>p]:text-[1.08rem]"
    >
      <h1>
        About me.
        <br />
        <em>Hi, I’m anvian.</em>
      </h1>
      <p>
        I build Minecraft mods, tools, and experiments. Sometimes it’s a new
        tree. Sometimes it’s a better way to test a mod. There’s always
        something else to explore.
      </p>
      <p>You can find my projects and follow what I’m working on here.</p>
      <div
        class="mt-[30px] flex flex-wrap gap-6 text-green [&>a]:inline-flex [&>a]:items-center [&>a]:gap-2"
      >
        <a href="https://github.com/anviaan"
          ><PlatformIcon name="github" />GitHub ↗</a
        >
        <a href="https://modrinth.com/user/anvian"
          ><PlatformIcon name="modrinth" />Modrinth ↗</a
        >
        <a href="https://www.curseforge.com/members/anvian/projects">
          <PlatformIcon name="curseforge" />CurseForge ↗
        </a>
        <a href="https://x.com/carbajal_andre"><PlatformIcon name="x" />X ↗</a>
      </div>
    </div>
    <div
      class="flex min-w-0 items-center justify-center [&>img]:h-[480px] [&>img]:w-auto [&>img]:max-w-full [&>img]:object-contain [&>img]:[image-rendering:pixelated] max-[700px]:[&>img]:h-[360px]"
    >
      <img
        src="/images/anvian-skin.png"
        alt="anvian’s Minecraft character waving and turned toward the introduction"
        width="400"
        height="719"
        fetchpriority="high"
      />
    </div>
  </section>
  <section
    class="mx-auto max-w-[1440px] px-[5%] py-[65px] max-[700px]:px-[6%] max-[700px]:py-[45px]"
  >
    <div
      class="mb-9 flex items-end justify-between gap-6 max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-3.5 [&_p]:mt-3 [&_p]:mb-0"
    >
      <div>
        <h2>Small details. Big possibilities.</h2>
        <p>A few things I’ve been building.</p>
      </div>
      <a class="py-2 whitespace-nowrap text-green" href="/projects/">
        All projects ↗
      </a>
    </div>
    <div
      class:list={[
        'grid grid-cols-1 gap-5 min-[701px]:grid-cols-2',
        highlights.length === 4
          ? 'min-[1101px]:grid-cols-4'
          : 'min-[1101px]:grid-cols-3',
      ]}
    >
      {highlights.map((p) => <Project project={p} />)}
    </div>
  </section>
  <section
    class="mx-auto mt-[30px] max-w-[1440px] border-t border-line px-[5%] py-[65px] max-[700px]:px-[6%] max-[700px]:py-[45px]"
  >
    <div
      class="mb-9 flex items-end justify-between gap-6 max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-3.5 [&_p]:mt-3 [&_p]:mb-0"
    >
      <div>
        <h2>From the workbench.</h2>
        <p>Notes on modding, development, and figuring things out.</p>
      </div>
      <a class="py-2 whitespace-nowrap text-green" href="/blog/">
        Read the blog ↗
      </a>
    </div>
    {
      posts.slice(0, 3).map((p) => (
        <a
          class="flex items-center gap-[30px] border-b border-line py-[30px] max-[700px]:flex-wrap max-[700px]:gap-[18px] [&_h2]:text-[1.6rem] [&_p]:mt-2 [&_p]:mb-0 [&_p]:text-[.92rem] [&>div]:min-w-0 [&>div]:flex-1 max-[700px]:[&>div]:basis-4/5 [&>img]:h-[140px] [&>img]:w-[230px] [&>img]:rounded-xl [&>img]:object-cover max-[700px]:[&>img]:h-auto max-[700px]:[&>img]:w-full [&>span]:text-[1.4rem] [&>span]:text-green [&>time]:shrink-0 [&>time]:basis-[125px] [&>time]:text-[.85rem] [&>time]:text-muted max-[700px]:[&>time]:basis-full"
          href={`/blog/${p.id}/`}
        >
          {p.data.image && (
            <img
              src={'/' + p.data.image.replace(/^\//, '')}
              alt=""
              width="230"
              height="140"
              loading="lazy"
            />
          )}
          <time datetime={p.data.date.toISOString()}>
            {p.data.date.toLocaleDateString('en', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
          <div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </section>
</Layout>
