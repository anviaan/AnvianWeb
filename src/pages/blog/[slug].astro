---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('blog', (p) => !p.data.draft)).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Anvian`}
  description={post.data.description}
  image={post.data.image ? '/' + post.data.image : undefined}
>
  <article
    class="mx-auto max-w-[1000px] px-[5%] py-[65px] max-[700px]:px-[6%] max-[700px]:py-[45px] max-[700px]:pt-10 [&>h1]:mt-[35px] [&>h1]:mb-5 [&>h1]:text-[clamp(2.2rem,4vw,3.7rem)] max-[700px]:[&>h1]:text-[2.2rem]"
  >
    <a class="py-2 whitespace-nowrap text-green" href="/blog/">
      ← Back to the blog
    </a>
    <h1>{post.data.title}</h1>
    <p class="text-[.88rem]">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toISOString().slice(0, 10)}
      </time>{' '}
      · By Anvian
    </p>
    {
      post.data.image && (
        <img
          class="my-[35px] rounded-xl"
          src={'/' + post.data.image}
          alt="mcmodtest dashboard"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<script>
  const blocks = document.querySelectorAll<HTMLElement>(
    'pre[data-language="mermaid"]',
  );
  if (blocks.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      securityLevel: 'strict',
    });
    for (const [index, block] of Array.from(blocks).entries()) {
      try {
        const { svg } = await mermaid.render(
          'diagram-' + index,
          block.textContent ?? '',
        );
        const figure = document.createElement('figure');
        figure.className = 'diagram';
        figure.innerHTML = svg;
        block.replaceWith(figure);
      } catch {
        /* Keep the readable source if diagram rendering fails. */
      }
    }
  }
</script>
