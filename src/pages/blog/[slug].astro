---
import Layout from '../../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',p=>!p.data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<Layout title={`${post.data.title} — Anvian`} description={post.data.description} image={post.data.image?'/'+post.data.image:undefined}><article class="article section"><a class="text-link" href="/blog/">← Back to the blog</a><h1>{post.data.title}</h1><p class="article-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time> · By Anvian</p>{post.data.image&&<img class="article-cover" src={'/'+post.data.image} alt="mcmodtest dashboard"/>}<div class="prose"><Content/></div></article></Layout>

<script>
const blocks=document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
if(blocks.length){
 const {default:mermaid}=await import('mermaid');
 mermaid.initialize({startOnLoad:false,theme:'dark',securityLevel:'strict'});
 for(const [index,block] of Array.from(blocks).entries()){
  try { const {svg}=await mermaid.render('diagram-'+index,block.textContent??'');const figure=document.createElement('figure');figure.className='diagram';figure.innerHTML=svg;block.replaceWith(figure); }
  catch { /* Keep the readable source if diagram rendering fails. */ }
 }
}
</script>
