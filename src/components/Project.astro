---
import {labels,total,partial,count,type Project} from '../data/catalog';
interface Props {project:Project}
const {project:p}=Astro.props;
const sources=Object.entries(p.sources);
const links={...p.platformLinks,...Object.fromEntries(sources.map(([name,s])=>[name,s.url]))};
---
<article class="project" data-name={p.name.toLowerCase()} data-type={p.type} data-downloads={total(p)}>
<div class="project-heading">{p.icon&&<img src={p.icon} alt="" width="56" height="56" loading="lazy"/>}<div><span class="type">{labels[p.type]??p.type}</span><h3>{p.name}</h3></div></div>
<p class="project-description">{p.description}</p>
<div class="download"><strong>{count(total(p))}</strong> downloads {partial(p)&&<span class="status">· partial total</span>}{Object.values(p.sources).some(s=>s.stale)&&<span class="status"> · last known counts</span>}</div>
<details><summary>Download breakdown</summary><ul>{sources.map(([name,s])=><li>{name==='modrinth'?'Modrinth':'CurseForge'}: {s.downloads.toLocaleString('en')}<br/><small>Updated <time datetime={s.updatedAt}>{s.updatedAt.slice(0,10)}</time>{s.stale?' · last known count':''}</small></li>)}{p.expectedSources.filter(name=>!(name in p.sources)).map(name=><li>{name}: unavailable</li>)}</ul><small>Downloads reported by platforms, not unique players.</small></details>
<div class="project-links">{Object.entries(links).map(([name,url])=><a href={url} aria-label={`${p.name} on ${name}`}>{name==='modrinth'?'Modrinth':'CurseForge'} <span aria-hidden="true">↗</span></a>)}{p.github&&<a href={p.github} aria-label={`${p.name} source on GitHub`}>GitHub <span aria-hidden="true">↗</span></a>}</div>
</article>
