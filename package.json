{
  "name": "anvian-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check": "bun --bun astro check && bun --bun tsc --noEmit -p scripts/tsconfig.json",
    "test": "bun test",
    "sync": "bun scripts/sync.ts",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "astro": "^7.3.7",
    "mermaid": "^12.1.0",
    "simple-icons": "^16.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "~1.3.14",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "katex": "^0.19.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
